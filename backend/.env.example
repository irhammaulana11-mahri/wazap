PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wazap_db
DB_USERNAME=wazap_user
DB_PASSWORD=
# Wajib diisi. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Fase B
DB_SCHEMA=gateway
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# COOKIE_SECURE=true   (default: true bila NODE_ENV=production)

# Fase C (nilai default)
ENGINE_LEASE_TTL_SECONDS=30
ENGINE_HEARTBEAT_SECONDS=10
ENGINE_SUSPECT_AFTER_SECONDS=30
ENGINE_UNHEALTHY_AFTER_SECONDS=60
CONTROL_PLANE_INTERVAL_MS=5000
ENABLE_EMBEDDED_CONTROL_PLANE=true

# Fase D: engine & kredensial
ENABLE_EMBEDDED_ENGINE=true
# Nama node stabil (restart memakai identitas yang sama). Default: hostname.
# ENGINE_NODE_NAME=engine-1
# Batas kapasitas engine: pengaman konfigurasi, BUKAN angka hasil benchmark. Tentukan lewat load test.
ENGINE_MAX_SESSIONS=10
ENGINE_WEIGHT=1
# ENGINE_MIN_FREE_MEM_MB=512
ENGINE_SYNC_INTERVAL_MS=2000
RECONNECT_BASE_MS=1000
RECONNECT_MAX_MS=60000
RECONNECT_MAX_ATTEMPTS=10
QR_TTL_SECONDS=60
# Wajib bila engine aktif. Format versi:base64(32 byte), pisah koma untuk rotasi. Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEYS=
# CREDENTIAL_ACTIVE_KEY_VERSION=1

# Fase E: antrean pesan
MESSAGE_MAX_ATTEMPTS=3
MESSAGE_RETRY_BASE_MS=5000
MESSAGE_RETRY_MAX_MS=300000
# Job PROCESSING yang melewati batas ini (engine mati saat kirim) => RECONCILIATION_REQUIRED, TIDAK di-retry otomatis
MESSAGE_PROCESSING_TIMEOUT_SECONDS=120
# Job PENDING lebih tua dari ini => FAILED (EXPIRED)
MESSAGE_TTL_SECONDS=86400
MESSAGE_MAX_LENGTH=4096
MAX_PENDING_PER_TENANT=1000
SEND_TIMEOUT_MS=30000
# Jeda minimum antar pengiriman dalam satu sesi (anti-ban); bukan angka hasil benchmark
SESSION_SEND_INTERVAL_MS=1500
QUEUE_POLL_MS=1000
VERIFY_RECIPIENT=true

# Fase F1: webhook (outbox relay + pengirim)
ENABLE_EMBEDDED_WEBHOOK_WORKER=true
OUTBOX_POLL_MS=500
WEBHOOK_POLL_MS=1000
WEBHOOK_BATCH=20
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_BASE_MS=10000
WEBHOOK_RETRY_MAX_MS=3600000
WEBHOOK_MAX_ENDPOINTS=10
# DEFAULT AMAN: hanya https ke alamat publik. JANGAN aktifkan di produksi (SSRF).
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Fase F2: realtime (Socket.IO)
REALTIME_MAX_SOCKETS_PER_TENANT=50
REALTIME_REVALIDATE_SECONDS=30

# Fase F4: media & bulk
MEDIA_MAX_BYTES=16777216
MEDIA_FETCH_TIMEOUT_MS=20000
# DEFAULT AMAN: hanya https ke alamat publik. JANGAN aktifkan di produksi (SSRF).
MEDIA_ALLOW_HTTP=false
MEDIA_ALLOW_PRIVATE_TARGETS=false
BULK_MAX_MESSAGES=100

# Fase F5: retensi (hari). CONTENT <= ROW. Angka disetujui: 30 / 180 / 7 / 30.
ENABLE_EMBEDDED_RETENTION=true
RETENTION_CONTENT_DAYS=30
RETENTION_ROW_DAYS=180
RETENTION_OUTBOX_DAYS=7
RETENTION_WEBHOOK_DELIVERY_DAYS=30
RETENTION_INTERVAL_MINUTES=60
RETENTION_BATCH=500

# Fase G: hardening
# Pemisahan role DB (lihat docs/07_DEPLOYMENT/DB_ROLES.md). Kosongkan di dev (migrasi memakai DB_USERNAME).
# DB_MIGRATE_USERNAME=wazap_migrator
# DB_MIGRATE_PASSWORD=
AUTO_MIGRATE=true
# enforce = tolak start bila role runtime superuser/BYPASSRLS (default di production); warn = peringatan saja (default dev)
# DB_ROLE_CHECK=enforce
API_RATE_LIMIT_IP_PER_MINUTE=600
API_RATE_LIMIT_TENANT_PER_MINUTE=1200
# true HANYA bila di belakang reverse proxy tepercaya
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=30000
WEBHOOK_AUTO_DISABLE_AFTER=10
LIST_COUNT_CAP=10000

# Fase H: tim
TEAM_INVITATION_TTL_HOURS=168
# Fase H3: masa berlaku permintaan bergabung (hari); lewat masa ini tidak dapat disetujui
JOIN_REQUEST_TTL_DAYS=14
# Batas permintaan bergabung yang menunggu per tenant (409 JOIN_QUEUE_FULL bila penuh)
JOIN_MAX_PENDING=50
# Hari sebelum permintaan bergabung yang sudah diputuskan/kedaluwarsa dihapus retensi
RETENTION_JOIN_REQUEST_DAYS=90
# Hari setelah workspace dihapus (status DELETED): seluruh datanya dihapus permanen
RETENTION_TENANT_DAYS=30

# Fase H2: undangan tanpa email, audit, batas atas kuota
# Alamat DASHBOARD (frontend) yang dibuka pengguna di browser --- BUKAN alamat API/backend (port 3000). Dipakai membangun invite_url = <nilai>/invite#token=... (fragmen: tidak masuk access log)
# Format: http(s)://host[:port][/subpath]; tanpa kredensial/query/fragment; di production wajib https. Kosong = frontend membangun dari origin-nya sendiri.
#   dev:        DASHBOARD_BASE_URL=http://localhost:5173
#   production: DASHBOARD_BASE_URL=https://wa.contoh.co.id          (atau https://intranet.contoh.co.id/wazap bila dashboard di-host di subpath)
# DASHBOARD_BASE_URL=
RETENTION_AUDIT_DAYS=365
# Batas atas yang boleh diatur OWNER lewat PATCH /tenant/settings. Samakan dengan nilai bawaan tenant (3/20/10/60) agar kuota tidak dapat dinaikkan tenant.
LIMIT_CEIL_SESSIONS=10
LIMIT_CEIL_API_KEYS=50
LIMIT_CEIL_MEMBERS=50
LIMIT_CEIL_MESSAGES_PER_MINUTE=120
