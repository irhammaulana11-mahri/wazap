{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && rm -rf dist/database/migrations && cp -r src/database/migrations dist/database/",
    "start": "node dist/server.js",
    "dev:worker": "tsx watch src/worker.ts",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/database/migrate-cli.ts",
    "migrate:prod": "node dist/database/migrate-cli.js",
    "keys:rotate": "tsx src/runtime/rotate-keys-cli.ts",
    "admin:recovery-code": "tsx src/runtime/recovery-code-cli.ts",
    "typecheck": "tsc --noEmit",
    "openapi": "tsx src/http/openapi/generate-cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:contract": "WAZAP_CONTRACT_CHECK=1 node --import tsx --test test/*.test.ts",
    "test:perf": "node --import tsx --test --test-timeout=900000 test/perf/*.perf.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@node-rs/argon2": "2.2.2",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
